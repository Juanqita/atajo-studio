# Copy this file to .env and fill in your values. Never commit .env.

# Instagram Graph API (Business Discovery)
IG_ACCESS_TOKEN=your_long_lived_token_here
IG_BUSINESS_ACCOUNT_ID=your_ig_business_account_id

# LLM (optional, for scoring / enrichment)
OPENAI_API_KEY=your_key_here

# Web app database
DATABASE_URL=sqlite:///./consultoria.db
